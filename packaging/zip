#!/usr/bin/env bash
# dist/opensim-engine-VERSION.zip: the project and its vendor folder (see packaging/stage), to unzip and use without
# composer or any other tool.

set -e
cd "$(dirname "$0")/.."

eval "$(packaging/version)"
packaging/stage build/zip/opensim-engine zip
mkdir -p dist
rm -f "dist/opensim-engine-$VERSION.zip"
(cd build/zip && zip -qr "$OLDPWD/dist/opensim-engine-$VERSION.zip" opensim-engine)
echo "dist/opensim-engine-$VERSION.zip"
