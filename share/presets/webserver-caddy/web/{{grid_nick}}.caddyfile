# Helpers of the grid {{grid_nick}}. It only takes the paths of the helpers. In the site block of the grid, add:
#     import {{grid_dir}}/web/{{grid_nick}}.caddyfile
@opensim_helpers path {{web_globs}}
handle @opensim_helpers {
	root * {{docroot}}
	php_fastcgi unix/{{php_socket}} {
		env OPENSIM_GRID {{grid_nick}}
	}
}
