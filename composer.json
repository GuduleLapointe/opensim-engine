{
    "name": "magicoli/opensim-engine",
    "description": "OpenSimulator Engine - Framework-agnostic core functionality for OpenSim grids",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gudule Lapointe",
            "email": "gudule@speculoos.world"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-filter": "*",
        "ext-imagick": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-simplexml": "*",
        "magicoli/opensim-rest-php": "^1.1.3",
        "phpxmlrpc/phpxmlrpc": "^4.11",
        "magicoli/kick-inside": "^0.1.0",
        "symfony/yaml": "^7.4",
        "nubs/random-name-generator": "^2.2",
        "laminas/laminas-escaper": "^2.12@stable",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "magicoli/pest-failure-summary": "^1.0",
        "pestphp/pest": "^3.0",
        "phpcompatibility/php-compatibility": "dev-develop",
        "squizlabs/php_codesniffer": "^4.0",
        "magicoli/bash-tools": "^1.0.7",
        "magicoli/build-tools": "^0.1.2",
        "nyholm/psr7": "^1.8"
    },
    "minimum-stability": "dev",
    "bin": [
        "bin/opensim-api"
    ],
    "autoload": {
        "psr-4": {
            "OpenSim\\": "src/"
        },
        "files": [
            "includes/functions-gettext.php",
            "includes/constants.php",
            "includes/polyfills.php"
        ]
    },
    "suggest": {
        "nyholm/psr7": "A PSR-7 and PSR-17 implementation to serve the API with Api\\Handler (any other works)",
        "ext-gettext": "To translate the messages; without it they stay in English",
        "ezyang/htmlpurifier": "For advanced HTML sanitization if rich content is needed"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "docs": "php dev/api-docs.php"
    }
}
