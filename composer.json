{
  "name": "magicoli/opensim-engine",
  "description": "OpenSimulator Engine - Framework-agnostic core functionality for OpenSim grids",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Gudule Lapointe",
      "email": "gudule@speculoos.world"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-filter": "*",
    "ext-gettext": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-pdo": "*",
    "ext-session": "*",
    "ext-simplexml": "*",
    "laminas/laminas-escaper": "2.19.x-dev",
    "magicoli/opensim-rest-php": "dev-opensim-kit",
    "phpxmlrpc/phpxmlrpc": "^4.11"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "magicoli/pest-failure-summary": "^1.0",
    "pestphp/pest": "^3.0",
    "phpcompatibility/php-compatibility": "dev-develop",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "repositories": [],
  "minimum-stability": "dev",
  "autoload": {
    "psr-4": {
      "OpenSim\\Engine\\": "src/"
    },
    "files": [
      "includes/functions-escaping.php"
    ]
  },
  "suggest": {
    "ezyang/htmlpurifier": "For advanced HTML sanitization if rich content is needed"
  },
  "config": {
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest"
  }
}
