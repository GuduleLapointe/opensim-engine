# Sourced by the scripts of the ecosystem, never run: reads the rc files that exist, so that the environment of the tools (which php,
# OPENSIM_* variables, PATH...) is set once, in bash, in a file of the user. The system file comes first, the user's after (it wins),
# then the one OPENSIM_RC names. What an rc file assigns is exported.
#
#   /etc/opensim/opensimrc, ~/.opensimrc, ~/.config/opensim/opensimrc, $OPENSIM_RC
#
# Example (~/.opensimrc):  PHP=/opt/homebrew/bin/php
#                          OPENSIM_CONF=~/opensim/opensim.conf

for opensim_rc in /etc/opensim/opensimrc "${HOME:-}/.opensimrc" "${XDG_CONFIG_HOME:-${HOME:-}/.config}/opensim/opensimrc" "${OPENSIM_RC:-}"; do
    [[ -n "$opensim_rc" && -r "$opensim_rc" ]] || continue
    opensim_rc_restore=+a
    [[ $- == *a* ]] && opensim_rc_restore=-a
    set -a
    # shellcheck disable=SC1090
    source "$opensim_rc"
    set "$opensim_rc_restore"
done
unset opensim_rc opensim_rc_restore
